+        UE_LOG(LogTemp,Display,TEXT("SOUL_COMPOSITION_TRAVEL_PASS legal_moves=%d ferry_legs=%d teleports=0 ownership_overrides=0"),Index,FerryLegs);
+        bDone=true;FPlatformMisc::RequestExitWithStatus(false,0);return;
+    }
